    <div class="modal-actions">
      <button class="btn" data-close="finishModal">Keep working</button>
      <button class="btn" id="btnGotoReview" style="display:none;">Review answers</button>
      <button class="btn btn-danger" id="btnConfirmFinish">Confirm &amp; grade</button>
    </div>
  </div>
</div>

<div class="modal-backdrop" id="resetModal" role="dialog" aria-modal="true">
  <div class="modal-card">
    <div class="modal-icon"><svg class="icon" style="width:34px;height:34px;"><use href="#i-restart"/></svg></div>
    <h3>Reset examination?</h3>
    <p>All answers, flags and progress will be cleared. This cannot be undone.</p>
    <div class="modal-actions">
      <button class="btn" data-close="resetModal">Cancel</button>
      <button class="btn btn-danger" id="btnConfirmReset">Reset test</button>
    </div>
  </div>
</div>

<div class="toast" id="toast" role="status"></div>

<script>
"use strict";
/* ================= Data (injected at build time) ================= */
const EXAM = __EXAM_JSON__;
const TRANSCRIPT = __TRANSCRIPT_JSON__;
const QMETA = __QMETA_JSON__;   // {qid: {id, part, type, time, answers, quote, analysis, labels}}
const PASSAGE_DATA = __PASSAGE_JSON__;
const AUDIO_FILE = __AUDIO_FILE__;
const PART_RANGES = { 1: [1, 10], 2: [11, 20], 3: [21, 30], 4: [31, 40] };
const TIME_LIMIT = EXAM.time_limit_sec || 1800;
const LS_KEY = "ielts_cdi_v7";

/* ================= State ================= */
let S = {
  stage: "cloze",        // 'cloze' | 'exam'
  mode: null,            // 'practice' | 'exam' (for Stage 2)
  started: false,
  answers: {},           // qid -> string
  flagged: [],           // [qid]
  evaluated: false,
  remain: TIME_LIMIT,
  furthest: 0,
  transient: false,      // true for ?demo/?grade QA runs — never persist

  // Stage 1 cloze state
  clozeAnswers: {},      // bid -> string
  clozeCheckedParts: {}, // partNum -> bool
  clozeRevealedParts: {},// partNum -> bool
  activeClozePart: 1
};
let activePart = 1;
let currentTid = null;
let activeSentId = null;
let autoScroll = true;
let toastTimer = null;

/* ================= DOM handles ================= */
const $ = (id) => document.getElementById(id);
const audio = $("audio");

/* ================= Utilities ================= */
function esc(s) {
  return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;")
    .replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;");
}
function secToStr(s) {
  s = Math.max(0, Math.floor(s));
  return String(Math.floor(s / 60)).padStart(2, "0") + ":" + String(s % 60).padStart(2, "0");
}
function norm(s) {
  return String(s || "").trim().toLowerCase()
    .replace(/[\u2019\u2018`]/g, "'").replace(/&/g, "and")
    .replace(/[.,!?;:]+$/, "").replace(/\s+/g, " ");
}
function toast(msg, ms) {
  const t = $("toast");
  t.textContent = msg;
  t.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove("show"), ms || 2600);
}
function qmeta(qid) { return QMETA[qid] || null; }
function partOf(qid) { return qid <= 10 ? 1 : qid <= 20 ? 2 : qid <= 30 ? 3 : 4; }
function labelFor(m, val) {
  if (!m || m.type !== "option" || !val) return val;
  const src = m.labels && m.labels[val] ? m.labels[val] : val;
  return src.length > 64 ? src.slice(0, 61) + "…" : src;
}
function isAnswered(qid) { const v = S.answers[qid]; return v !== undefined && v !== null && String(v).trim() !== ""; }

/* ================= Persistence ================= */
function persist() {
  if (S.transient) return;
  try {
    localStorage.setItem(LS_KEY, JSON.stringify({
      stage: S.stage, mode: S.mode, started: S.started, answers: S.answers, flagged: S.flagged,
      evaluated: S.evaluated, remain: S.remain, furthest: S.furthest,
      clozeAnswers: S.clozeAnswers, clozeCheckedParts: S.clozeCheckedParts,
      clozeRevealedParts: S.clozeRevealedParts, activeClozePart: S.activeClozePart,
      savedAt: Date.now()
    }));
    $("saveLabel").innerHTML = '<svg class="icon" style="color:var(--green)"><use href="#i-check"/></svg> Saved ' +
      new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
  } catch (e) { /* storage unavailable — run in memory */ }
}
function restore() {
  try {
    const raw = localStorage.getItem(LS_KEY);
    if (!raw) return false;
    const st = JSON.parse(raw);
    if (!st || !st.started) return false;
    S.stage = st.stage || "cloze";
    S.mode = st.mode === "exam" ? "exam" : "practice";
    S.started = true;
    S.answers = st.answers || {};
    S.flagged = Array.isArray(st.flagged) ? st.flagged : [];
    S.evaluated = !!st.evaluated;
    S.remain = typeof st.remain === "number" ? st.remain : TIME_LIMIT;
    S.furthest = st.furthest || 0;
    S.clozeAnswers = st.clozeAnswers || {};
    S.clozeCheckedParts = st.clozeCheckedParts || {};
    S.clozeRevealedParts = st.clozeRevealedParts || {};
    S.activeClozePart = st.activeClozePart || 1;
    return true;
  } catch (e) { return false; }
}

/* ================= Stage 1: Passage Cloze Logic ================= */
function getClozeBlanks(pNum) {
  const p = (PASSAGE_DATA || []).find(x => x.part === pNum);
  if (!p) return [];
  const blanks = [];
  (p.sentences || []).forEach(s => { if (s.blanks) blanks.push(...s.blanks); });
  return blanks;
}

function renderClozeTabs() {
  const tabs = $("clozePartTabs");
  if (!tabs || !PASSAGE_DATA || !PASSAGE_DATA.length) return;
  let html = "";
  PASSAGE_DATA.forEach(p => {
    const blanks = getClozeBlanks(p.part);
    const bMin = blanks.length ? blanks[0].id : 0;
    const bMax = blanks.length ? blanks[blanks.length - 1].id : 0;
    let done = 0;
    blanks.forEach(b => { if ((S.clozeAnswers[b.id] || "").trim()) done++; });
    const isAct = S.activeClozePart === p.part;
    html += `<button type="button" class="tab-btn${isAct ? " active" : ""}" onclick="jumpClozePart(${p.part})">
      Part ${p.part} (${bMin}–${bMax}) <span class="tab-count">${done}/${blanks.length}</span>
    </button>`;
  });
  tabs.innerHTML = html;
}

function renderClozePart() {
  const container = $("passageArea");
  if (!container) return;
  if (!PASSAGE_DATA || !PASSAGE_DATA.length) {
    container.innerHTML = '<div class="sheet"><p>未找到原文精听复现数据。</p></div>';
    return;
  }
  const pData = PASSAGE_DATA.find(p => p.part === S.activeClozePart) || PASSAGE_DATA[0];
  const isChecked = !!S.clozeCheckedParts[pData.part];
  const isRevealed = !!S.clozeRevealedParts[pData.part];

  renderClozeTabs();

  const blanks = getClozeBlanks(pData.part);
  let done = 0, correct = 0;
  blanks.forEach(b => {
    const val = (S.clozeAnswers[b.id] || "").trim();
    if (val) done++;
    if (norm(val) === norm(b.answer)) correct++;
  });

  const pct = blanks.length > 0 ? Math.round(correct / blanks.length * 100) : 0;
  const scoreHtml = isChecked ? `<span class="passage-score-pill">本段得分: ${correct}/${blanks.length} (${pct}%)</span>` : "";

  let html = `<div class="passage-card">
    <div class="passage-head">
      <div>
        <span class="passage-title">${esc(pData.title)}</span>
        <span class="passage-time">(${secToStr(pData.audio_start)} – ${secToStr(pData.audio_end)})</span>
      </div>
      <div class="passage-actions">
        ${scoreHtml}
        <div class="btn-group">
          <button type="button" class="btn-group-main" onclick="seekPlay(${pData.audio_start})">播放整段</button>
          <button type="button" onclick="checkClozePart(${pData.part})">检查填空</button>
          <button type="button" onclick="toggleRevealCloze(${pData.part})">${isRevealed ? "隐藏原文" : "对照原文"}</button>
          <button type="button" onclick="resetClozePart(${pData.part})" title="重置本段">重置</button>
        </div>
      </div>
    </div>`;

  let currentSpeaker = null;
  let paraOpen = false;

  pData.sentences.forEach(s => {
    if (s.speaker !== currentSpeaker) {
      if (paraOpen) html += `</p>`;
      currentSpeaker = s.speaker;
      html += `<p class="passage-para"><span class="para-spk">${esc(currentSpeaker)}</span>`;
      paraOpen = true;
    }

    let sentHtml = esc(s.cloze_text);
    (s.blanks || []).forEach(b => {
      const uVal = esc(S.clozeAnswers[b.id] || "");
      let cls = "cloze-input";
      if (isChecked) {
        cls += norm(S.clozeAnswers[b.id]) === norm(b.answer) ? " cloze-ok" : " cloze-no";
      }
      const peekStyle = isRevealed ? "" : "display:none;";
      const repl = `<span class="cloze-wrapper" id="cw-${b.id}">
        <span class="cloze-num">${b.id}</span>
        <input type="text" class="${cls}" data-bid="${b.id}" id="cloze-${b.id}"
               placeholder="${esc(b.hint)}" value="${uVal}"
               autocomplete="off" autocapitalize="off" spellcheck="false"
               oninput="onClozeInput(${b.id}, this.value)"
               onkeydown="onClozeKeydown(event, ${b.id})" aria-label="Blank ${b.id}">
        <span class="cloze-peek" id="peek-${b.id}" style="${peekStyle}">${esc(b.answer)}</span>
      </span>`;
      sentHtml = sentHtml.replace(`[[${esc(b.answer)}]]`, repl);
    });

    html += `<span class="sent-block" id="sent-${s.id}" data-start="${s.start}" data-end="${s.end}">
      <button type="button" class="sent-play-btn" onclick="seekPlay(${s.start})" title="播放此句 (${secToStr(s.start)})">▶</button>
      ${sentHtml}
    </span> `;
  });

  if (paraOpen) html += `</p>`;
  html += `</div>`;
  container.innerHTML = html;
  refreshClozeCounts();
}

function onClozeInput(bid, val) {
  S.clozeAnswers[bid] = val;
  const input = $("cloze-" + bid);
  if (input) input.classList.remove("cloze-ok", "cloze-no");
  refreshClozeCounts();
  persist();
}

function onClozeKeydown(e, bid) {
  if (e.key === "Enter") {
    e.preventDefault();
    const inputs = Array.from(document.querySelectorAll("#stageClozeWrap .cloze-input"));
    const idx = inputs.findIndex(el => el.dataset.bid === String(bid));
    if (idx >= 0 && idx + 1 < inputs.length) {
      inputs[idx + 1].focus();
    } else if (S.activeClozePart < PASSAGE_DATA.length) {
      jumpClozePart(S.activeClozePart + 1);
    }
  }
}

function checkClozePart(pNum) {
  S.clozeCheckedParts[pNum] = true;
  const blanks = getClozeBlanks(pNum);
  let correct = 0;
  blanks.forEach(b => {
    const isOk = norm(S.clozeAnswers[b.id]) === norm(b.answer);
    if (isOk) correct++;
    const input = $("cloze-" + b.id);
    if (input) {
      input.classList.remove("cloze-ok", "cloze-no");
      input.classList.add(isOk ? "cloze-ok" : "cloze-no");
    }
  });
  renderClozePart();
  const pct = blanks.length > 0 ? Math.round(correct / blanks.length * 100) : 0;
  toast(`Part ${pNum} 检查完成：${correct}/${blanks.length} 正确 (${pct}%)`, 3600);
  persist();
}

function toggleRevealCloze(pNum) {
  S.clozeRevealedParts[pNum] = !S.clozeRevealedParts[pNum];
  renderClozePart();
  persist();
}

function resetClozePart(pNum) {
  const blanks = getClozeBlanks(pNum);
  blanks.forEach(b => { delete S.clozeAnswers[b.id]; });
  delete S.clozeCheckedParts[pNum];
  delete S.clozeRevealedParts[pNum];
  renderClozePart();
  toast(`Part ${pNum} 填空已重置`);
  persist();
}

function jumpClozePart(pNum) {
  S.activeClozePart = Math.min(PASSAGE_DATA.length, Math.max(1, parseInt(pNum, 10)));
  renderClozePart();
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function refreshClozeCounts() {
  let totalAll = 0, filledAll = 0;
  (PASSAGE_DATA || []).forEach(p => {
    const blanks = getClozeBlanks(p.part);
    totalAll += blanks.length;
    blanks.forEach(b => { if ((S.clozeAnswers[b.id] || "").trim()) filledAll++; });
  });
  if ($("clozeStatsCount")) $("clozeStatsCount").textContent = filledAll;
  if ($("clozeStatsTotal")) $("clozeStatsTotal").textContent = totalAll;
  renderClozeDock();
}

function renderClozeDock() {
  const box = $("clozePaletteBox");
  if (!box || !PASSAGE_DATA) return;
  let html = "";
  PASSAGE_DATA.forEach(p => {
    const blanks = getClozeBlanks(p.part);
    let done = 0;
    blanks.forEach(b => { if ((S.clozeAnswers[b.id] || "").trim()) done++; });
    const isAct = S.activeClozePart === p.part;
    html += `<button type="button" class="btn btn-sm${isAct ? " btn-primary" : ""}" onclick="jumpClozePart(${p.part})">
      Part ${p.part} (${done}/${blanks.length})
    </button>`;
  });
  box.innerHTML = html;
  if (S.stage === "cloze" && $("dockCounter")) {
    const blanks = getClozeBlanks(S.activeClozePart);
    let done = 0;
    blanks.forEach(b => { if ((S.clozeAnswers[b.id] || "").trim()) done++; });
    $("dockCounter").innerHTML = `本段: <b>${done}</b>/${blanks.length} 已填`;
  }
}

function syncClozeSentence(cur) {
  const pData = (PASSAGE_DATA || []).find(p => p.part === S.activeClozePart);
  if (!pData) return;
  const match = pData.sentences.find(s => cur >= s.start && cur <= s.end);
  if (!match || match.id === activeSentId) return;

  const prev = $("sent-" + activeSentId);
  if (prev) prev.classList.remove("active-sent");
  const curEl = $("sent-" + match.id);
  if (curEl) {
    curEl.classList.add("active-sent");
    if (autoScroll) curEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }
  activeSentId = match.id;
}

function switchStage(stageName) {
  S.stage = stageName;
  const isCloze = stageName === "cloze";
  $("stageClozeWrap").style.display = isCloze ? "" : "none";
  $("stageExamWrap").style.display = isCloze ? "none" : "";
  $("clozeTopActions").style.display = isCloze ? "flex" : "none";
  $("examTopActions").style.display = isCloze ? "none" : "flex";
  $("clozePaletteBox").style.display = isCloze ? "flex" : "none";
  $("paletteBox").style.display = isCloze ? "none" : "flex";

  $("btnStageCloze").classList.toggle("active", isCloze);
  $("btnStageExam").classList.toggle("active", !isCloze);

  if (isCloze) {
    renderClozePart();
  } else {
    renderPartView();
    refreshCounts();
  }
  persist();
}

/* ================= Rendering ================= */
function renderTabs() {
  const tabs = $("partTabs");
  let html = "";
  for (let p = 1; p <= 4; p++) {
    const [a, b] = PART_RANGES[p];
    let done = 0;
    for (let i = a; i <= b; i++) if (isAnswered(i)) done++;
    html += `<button class="tab-btn${activePart === p ? " active" : ""}" data-part="${p}" id="tab-${p}">Part ${p} (Q${a}–${b}) <span class="tab-count">${done}/10</span></button>`;
  }
  html += `<button class="tab-btn transcript-tab${activePart === 5 ? " active" : ""}" data-part="5" id="tab-5"><svg class="icon"><use href="#i-doc"/></svg> Transcript</button>`;
  tabs.innerHTML = html;
  tabs.querySelectorAll(".tab-btn").forEach(b => b.addEventListener("click", () => jumpPart(parseInt(b.dataset.part, 10))));
}

function instructionBanner(pData) {
  return `<div class="instruction-banner">
    <div><div class="pt">${esc(pData.title)}</div><div class="pi">${esc(pData.instruction)}</div></div>
    <button class="clue-btn exam-only-hide" onclick="seekPlay(${pData.audio_start})"><svg class="icon"><use href="#i-play"/></svg> Play Part Audio (${secToStr(pData.audio_start)})</button>
  </div>`;
}

function blankHtml(qid, wide) {
  const m = qmeta(qid);
  const flagged = S.flagged.includes(qid) ? " flagged" : "";
  const badgeCls = S.evaluated && m ? (m._ok ? " graded-ok" : " graded-no") : flagged;
  const val = esc(S.answers[qid] || "");
  return `<span class="blank-wrap">
    <button type="button" class="q-badge${badgeCls}" onclick="toggleFlag(${qid})" title="Question ${qid} — click to flag" aria-label="Flag question ${qid}">${qid}</button>
    <input type="text" class="cdi-input" data-qid="${qid}" id="ctrl-${qid}" value="${val}" ${wide ? 'style="min-width:210px"' : ""}
      placeholder="…" autocomplete="off" autocapitalize="off" spellcheck="false"
      oninput="recordText(${qid}, this.value)" onkeydown="handleInputKey(event, ${qid})" aria-label="Answer for question ${qid}">
  </span>`;
}

function letterSelect(qid, keys, labels) {
  const m = qmeta(qid);
  const flagged = S.flagged.includes(qid) ? " flagged" : "";
  const badgeCls = S.evaluated && m ? (m._ok ? " graded-ok" : " graded-no") : flagged;
  const cur = esc(S.answers[qid] || "");
  let opts = `<option value="">…</option>`;
  keys.forEach((k, i) => { opts += `<option value="${k}"${cur === k ? " selected" : ""}>${k} — ${esc(labels[i])}</option>`; });
  return `<span class="blank-wrap">
    <button type="button" class="q-badge${badgeCls}" onclick="toggleFlag(${qid})" title="Question ${qid} — click to flag" aria-label="Flag question ${qid}">${qid}</button>
    <select class="ans-select" data-qid="${qid}" id="ctrl-${qid}" onchange="recordSelect(${qid}, this.value)" aria-label="Answer for question ${qid}">${opts}</select>
  </span>`;
}

function fbSlot(qid) { return `<div class="fb" id="fb-${qid}" hidden></div>`; }

function renderPartView() {
  const qArea = $("questionsArea");
  const tArea = $("transcriptArea");
  renderTabs();
  if (activePart === 5) {
    qArea.style.display = "none";
    tArea.style.display = "";
    return;
  }
  qArea.style.display = "";
  tArea.style.display = "none";
  const pData = EXAM.parts.find(p => p.part === activePart);
  if (!pData) return;
  let html = instructionBanner(pData);

  if (pData.sections) { // Parts 1 & 4 — Cambridge note sheets
    html += `<div class="sheet"><div class="sheet-title">${esc(pData.sheet_title || pData.title.replace(/^Part \d+: /, ""))}</div>`;
    pData.sections.forEach(sec => {
      html += `<div class="sheet-subtitle"><span>${esc(sec.title)}</span>
        <button class="clue-btn exam-only-hide" onclick="seekPlay(${sec.time})"><svg class="icon"><use href="#i-play"/></svg> Listen (${secToStr(sec.time)})</button></div>
        <ul class="note-list">`;
      sec.notes.forEach(n => {
        if (!n.id) { html += `<li class="note-item">${esc(n.prefix)}</li>`; return; }
        html += `<li class="note-item">${esc(n.prefix)}${blankHtml(n.id)}${esc(n.suffix || "")}${fbSlot(n.id)}</li>`;
      });
      html += `</ul>`;
    });
    html += `</div>`;

  } else if (pData.mcq) { // Part 2 — MCQ + matching
    pData.mcq.forEach(q => {
      html += `<div class="mcq-card" id="qwrap-${q.id}">
        <div class="mcq-head"><span><span class="q-num">${q.id}.</span>${esc(q.prompt)}</span>
        <button class="clue-btn exam-only-hide" onclick="seekPlay(${q.time})"><svg class="icon"><use href="#i-play"/></svg> ${secToStr(q.time)}</button></div>`;
      q.options.forEach(o => {
        const cls = S.answers[q.id] === o.key ? " active" : "";
        html += `<button type="button" class="option-btn${cls}" data-qid="${q.id}" id="ctrl-${q.id}" onclick="recordOption(${q.id},'${o.key}')">
          <span class="option-key">${o.key}</span><span>${esc(o.text)}</span></button>`;
      });
      html += fbSlot(q.id) + `</div>`;
    });
    html += `<div class="sheet" id="qwrap-matching"><div class="sheet-title">Questions 15–20: Match each phenomenon to its sector (A–F)</div>
      <div class="word-bank"><span class="wb-label">Available sectors</span>
      ${pData.matching.options.map(o => `<span class="word-chip"><b>${o.key}</b>${esc(o.text)}</span>`).join("")}</div>
      <ul class="note-list">`;
    pData.matching.items.forEach(it => {
      html += `<li class="note-item"><div class="match-row">
        <span><b style="font-family:var(--mono);color:var(--primary);margin-right:6px;">${it.id}.</b>${esc(it.prompt)}</span>
        <div class="match-controls">${letterSelect(it.id, pData.matching.options.map(o => o.key), pData.matching.options.map(o => o.text))}
        <button class="clue-btn exam-only-hide" onclick="seekPlay(${it.time})"><svg class="icon"><use href="#i-play"/></svg> ${secToStr(it.time)}</button></div>
        ${fbSlot(it.id)}</div></li>`;
    });
    html += `</ul></div>`;

  } else if (pData.word_bank) { // Part 3 — summary (word bank) + sentences
    html += `<div class="sheet"><div class="sheet-title">Academic Summary: complete with letters ${pData.word_bank[0].key}–${pData.word_bank[pData.word_bank.length - 1].key}</div>
      <div class="word-bank"><span class="wb-label">Word bank</span>
      ${pData.word_bank.map(w => `<span class="word-chip"><b>${w.key}</b>${esc(w.word)}</span>`).join("")}</div>
      <p class="summary-p">`;
    pData.summary_text.forEach((chunk, i) => {
      html += esc(chunk);
      const sq = pData.summary_questions[i];
      if (sq) html += letterSelect(sq.id, pData.word_bank.map(w => w.key), pData.word_bank.map(w => w.word));
    });
    html += `</p><ul class="fb-list" id="fbList"></ul></div>`;
    html += `<div class="sheet"><div class="sheet-title">Questions 27–30: Complete the sentences</div><ul class="note-list">`;
    pData.sentence_questions.forEach(sq => {
      html += `<li class="note-item">${esc(sq.prefix)}${blankHtml(sq.id)}${esc(sq.suffix || "")}
        <button class="clue-btn exam-only-hide" style="margin-left:8px" onclick="seekPlay(${sq.time})"><svg class="icon"><use href="#i-play"/></svg> ${secToStr(sq.time)}</button>${fbSlot(sq.id)}</li>`;
    });
    html += `</ul></div>`;
  }
  qArea.innerHTML = html;
  if (S.evaluated) applyGrading(false);
  refreshCounts();
}

/* ================= Answers & flags ================= */
function recordText(qid, val) {
  S.answers[qid] = val.trim();
  refreshCounts();
  persist();
}
function recordSelect(qid, val) {
  S.answers[qid] = val;
  refreshCounts();
  persist();
}
function recordOption(qid, key) {
  S.answers[qid] = key;
  const card = $("qwrap-" + qid);
  if (card) card.querySelectorAll(".option-btn").forEach(b => b.classList.toggle("active", b.getAttribute("onclick").includes("'" + key + "'")));
  refreshCounts();
  persist();
}
function toggleFlag(qid) {
  const i = S.flagged.indexOf(qid);
  if (i >= 0) S.flagged.splice(i, 1); else S.flagged.push(qid);
  document.querySelectorAll(`.q-badge[onclick="toggleFlag(${qid})"]`).forEach(b => b.classList.toggle("flagged", i < 0));
  const mf = document.getElementById("mflag-" + qid);
  if (mf) mf.classList.toggle("on", i < 0);
  refreshCounts();
  persist();
}
function handleInputKey(e, qid) {
  if (e.key !== "Enter") return;
  e.preventDefault();
  const inputs = Array.from(document.querySelectorAll("#questionsArea .cdi-input"));
  const idx = inputs.findIndex(el => el.dataset.qid === String(qid));
  if (idx >= 0 && idx + 1 < inputs.length) inputs[idx + 1].focus();
  else if (activePart < 4) jumpPart(activePart + 1);
}

/* ================= Palette / navigation ================= */
function buildPalette() {
  const box = $("paletteBox");
  let html = "";
  for (let p = 1; p <= 4; p++) {
    const [a, b] = PART_RANGES[p];
    html += `<span class="palette-group">`;
    for (let i = a; i <= b; i++) html += `<button class="dock-num" id="dock-${i}" title="Question ${i}" onclick="jumpQuestion(${i})">${i}</button>`;
    html += `</span>`;
    if (p < 4) html += `<span class="palette-gap"></span>`;
  }
  box.innerHTML = html;
}
function refreshCounts() {
  let done = 0;
  for (let i = 1; i <= 40; i++) {
    const btn = $("dock-" + i);
    if (!btn) continue;
    const ans = isAnswered(i);
    if (ans) done++;
    btn.classList.toggle("answered", ans && !S.evaluated);
    btn.classList.toggle("flagged", S.flagged.includes(i));
    if (S.evaluated) {
      const m = qmeta(i);
      btn.classList.toggle("graded-ok", !!(m && m._ok));
      btn.classList.toggle("graded-no", !!(m && !m._ok));
    }
  }
  $("ansCounter").textContent = done;
  document.querySelectorAll(".tab-btn[data-part]").forEach(b => {
    const p = parseInt(b.dataset.part, 10);
    if (p < 1 || p > 4) return;
    const [a, x] = PART_RANGES[p];
    let c = 0;
    for (let i = a; i <= x; i++) if (isAnswered(i)) c++;
    const tc = b.querySelector(".tab-count");
    if (tc) tc.textContent = c + "/10";
  });
}
function jumpPart(p) {
  if (p === 5 && S.mode === "exam" && !S.evaluated) {
    toast("The transcript is locked during the exam — it unlocks after grading.");
    return;
  }
  activePart = Math.min(5, Math.max(1, p));
  renderPartView();
  if (activePart !== 5) window.scrollTo({ top: 0, behavior: "smooth" });
  else syncTranscriptActive(audio.currentTime);
}
function jumpQuestion(qid) {
  const targetPart = partOf(qid);
  if (activePart !== targetPart) jumpPart(targetPart);
  setTimeout(() => {
    const el = $("qwrap-" + qid) || $("ctrl-" + qid) || $("fb-" + qid);
    if (!el) return;
    el.scrollIntoView({ behavior: "smooth", block: "center" });
    el.classList.remove("flash"); void el.offsetWidth; el.classList.add("flash");
    const ctrl = $("ctrl-" + qid);
    if (ctrl && ctrl.tagName === "INPUT") ctrl.focus({ preventScroll: true });
    document.querySelectorAll(".dock-num.current").forEach(d => d.classList.remove("current"));
    const dock = $("dock-" + qid);
    if (dock) { dock.classList.add("current"); dock.scrollIntoView({ block: "nearest", inline: "nearest" }); }
  }, 60);
}

/* ================= Audio engine ================= */
function bindAudio() {
  const playIcon = $("playIcon");
  $("btnPlay").addEventListener("click", togglePlay);
  audio.addEventListener("play", () => { playIcon.innerHTML = '<use href="#i-pause"/>'; });
  audio.addEventListener("pause", () => { playIcon.innerHTML = '<use href="#i-play"/>'; });
  audio.addEventListener("ended", () => {
    playIcon.innerHTML = '<use href="#i-play"/>';
    if (S.mode === "exam" && !S.evaluated) toast("Recording finished. Use the remaining time to complete your answers.");
  });
  audio.addEventListener("timeupdate", () => {
    $("timeCur").textContent = secToStr(audio.currentTime);
    if (S.mode === "exam" && !S.evaluated) {
      S.furthest = Math.max(S.furthest, audio.currentTime);
      if (Math.floor(audio.currentTime) % 5 === 0) persist();
    }
    $("seekSlider").value = audio.currentTime;
    if (S.stage === "cloze") {
      syncClozeSentence(audio.currentTime);
    } else if (activePart === 5) {
      syncTranscriptActive(audio.currentTime);
    }
  });
  audio.addEventListener("loadedmetadata", () => {
    $("seekSlider").max = audio.duration || 0;
    $("timeEnd").textContent = secToStr(audio.duration || 0);
  });
  audio.addEventListener("seeking", () => {
    if (S.mode === "exam" && !S.evaluated && Math.abs(audio.currentTime - S.furthest) > 0.35) {
      audio.currentTime = S.furthest;
      toast("The recording cannot be rewound during the test.");
    }
  });
  $("seekSlider").addEventListener("input", (e) => {
    if (S.mode === "exam" && !S.evaluated) { e.target.value = audio.currentTime; return; }
    audio.currentTime = parseFloat(e.target.value);
  });
  $("btnBack5").addEventListener("click", () => { if (canSeek()) audio.currentTime = Math.max(0, audio.currentTime - 5); });
  $("btnFwd5").addEventListener("click", () => { if (canSeek()) audio.currentTime = Math.min(audio.duration || 0, audio.currentTime + 5); });
  document.querySelectorAll(".speed-btn").forEach(b => b.addEventListener("click", () => {
    document.querySelectorAll(".speed-btn").forEach(x => x.classList.remove("active"));
    b.classList.add("active");
    audio.playbackRate = parseFloat(b.dataset.spd);
  }));
  $("volSlider").addEventListener("input", (e) => { audio.volume = parseFloat(e.target.value); });
}
function canSeek() { return !(S.mode === "exam" && !S.evaluated); }
function togglePlay() {
  if (audio.paused) { audio.play().catch(() => toast("Audio could not start — click the play button again.")); }
  else audio.pause();
}
function seekPlay(sec) {
  if (S.mode === "exam" && !S.evaluated) return;
  audio.currentTime = sec;
  audio.play().catch(() => {});
}

/* ================= Transcript ================= */
function renderTranscript() {
  $("transcriptList").innerHTML = TRANSCRIPT.map(t => `
    <div class="transcript-item" id="titem-${t.id}" data-start="${t.start}" onclick="seekPlay(${t.start})">
      <span class="spk-badge ${t.speaker === "Host 1" ? "spk-h1" : "spk-h2"}">${esc(t.speaker)}</span>
      <span class="ts-mono">${secToStr(t.start)}</span>
      <span style="flex:1">${esc(t.text)}</span>
    </div>`).join("");
}
function syncTranscriptActive(cur) {
  if (activePart !== 5) return;
  const match = TRANSCRIPT.find(t => cur >= t.start && cur <= t.end);
  if (!match || match.id === currentTid) return;
  const prev = $("titem-" + currentTid);
  if (prev) prev.classList.remove("active-line");
  const el = $("titem-" + match.id);
  if (el) {
    el.classList.add("active-line");
    if (autoScroll) el.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }
  currentTid = match.id;
}

/* ================= Review screen ================= */
function openReview() {
  const body = $("reviewBody");
  let rows = "", unanswered = 0;
  for (let i = 1; i <= 40; i++) {
    const m = qmeta(i);
    const ans = S.answers[i] || "";
    if (!isAnswered(i)) unanswered++;
    let status;
    if (S.evaluated) status = m._ok
      ? '<span class="status-icon ok"><svg class="icon"><use href="#i-check"/></svg>Correct</span>'
      : '<span class="status-icon no"><svg class="icon"><use href="#i-x"/></svg>Incorrect</span>';
    else status = isAnswered(i)
      ? '<span class="status-icon" style="color:var(--primary)"><svg class="icon"><use href="#i-check"/></svg>Answered</span>'
      : '<span class="status-icon un">— Unanswered</span>';
    const display = ans ? esc(labelFor(m, ans)) : "";
    rows += `<tr>
      <td><button class="review-q" onclick="closeOverlay('reviewOverlay');jumpQuestion(${i})">${i}</button></td>
      <td style="color:var(--ink-4);font-family:var(--mono);">P${partOf(i)}</td>
      <td>${status}</td>
      <td class="review-ans${ans ? "" : " blank"}">${display || "not answered"}</td>
      <td><button class="mini-flag${S.flagged.includes(i) ? " on" : ""}" id="mflag-${i}" onclick="toggleFlag(${i})" aria-label="Flag question ${i}"><svg class="icon"><use href="#i-flag"/></svg></button></td>
    </tr>`;
  }
  body.innerHTML = rows;
  $("reviewSummary").innerHTML = S.evaluated
    ? `Graded: <b style="color:var(--ink)">${Object.values(QMETA).filter(m => m._ok).length}</b>/40 correct`
    : `<b style="color:${unanswered ? "var(--red)" : "var(--green)"}">${unanswered}</b> of 40 questions unanswered`;
  $("btnReviewFinish").style.display = S.evaluated ? "none" : "";
  openOverlay("reviewOverlay");
}

/* ================= Finish & grading ================= */
function openFinishModal() {
  let unanswered = 0;
  for (let i = 1; i <= 40; i++) if (!isAnswered(i)) unanswered++;
  $("finishPrompt").innerHTML = unanswered > 0
    ? `You still have <b style="color:var(--red)">${unanswered}</b> unanswered question${unanswered === 1 ? "" : "s"}. Unanswered questions score zero.`
    : "All 40 questions are complete. Ready for your band score?";
  $("btnGotoReview").style.display = unanswered > 0 ? "" : "none";
  openModal("finishModal");
}
function scoreToBand(score) {
  if (score >= 39) return 9.0;
  if (score >= 37) return 8.5;
  if (score >= 35) return 8.0;
  if (score >= 32) return 7.5;
  if (score >= 30) return 7.0;
  if (score >= 26) return 6.5;
  if (score >= 23) return 6.0;
  if (score >= 18) return 5.5;
  if (score >= 16) return 5.0;
  if (score >= 13) return 4.5;
  if (score >= 10) return 4.0;
  if (score >= 8) return 3.5;
  if (score >= 6) return 3.0;
  if (score >= 4) return 2.5;
  return 2.0;
}
function recomputeGrades() {
  let correct = 0;
  for (let i = 1; i <= 40; i++) {
    const m = qmeta(i);
    if (!m) continue;
    const u = norm(S.answers[i]);
    m._ok = u !== "" && m.answers.some(a => norm(a) === u);
    if (m._ok) correct++;
  }
  return correct;
}
function updateReportUI(correct) {
  const band = scoreToBand(correct);
  document.body.classList.add("is-graded");
  $("bandDisplay").textContent = band.toFixed(1);
  $("rawDisplay").textContent = correct;
  $("pctDisplay").textContent = Math.round(correct / 40 * 100) + "%";
  $("wrongTotal").textContent = 40 - correct;
  $("correctTotal").textContent = correct;
  $("partBreakdown").innerHTML = Object.keys(PART_RANGES).map(p => {
    const [a, b] = PART_RANGES[p];
    let c = 0;
    for (let i = a; i <= b; i++) if (qmeta(i) && qmeta(i)._ok) c++;
    const pct = Math.round(c / (b - a + 1) * 100);
    return `<div class="pb-row"><span>Part ${p}</span><span class="pb-bar"><i style="width:${pct}%"></i></span><span style="text-align:right;font-family:var(--mono)">${c}/${b - a + 1}</span></div>`;
  }).join("");
}
function evaluateExam() {
  closeOverlay("reviewOverlay");
  closeModal("finishModal");
  S.evaluated = true;
  const correct = recomputeGrades();
  updateReportUI(correct);
  renderPartView();          // re-renders questions with grading applied + feedback injected
  window.scrollTo({ top: 0, behavior: "smooth" });
  toast(`Test graded — ${correct}/40 correct, Band ${scoreToBand(correct).toFixed(1)}`, 4200);
  persist();
}
function applyGrading(scrollToReport) {
  document.body.classList.add("is-graded");
  for (let i = 1; i <= 40; i++) {
    const m = qmeta(i);
    if (!m || m._ok === undefined) continue;
    const ctrl = $("ctrl-" + i);
    if (ctrl) {
      ctrl.classList.remove("graded-ok", "graded-no");
      ctrl.classList.add(m._ok ? "graded-ok" : "graded-no");
      if (ctrl.tagName === "BUTTON") ctrl.disabled = true;
      if (ctrl.tagName === "SELECT") ctrl.disabled = true;
    }
    document.querySelectorAll(`.q-badge[onclick="toggleFlag(${i})"]`).forEach(b => {
      b.classList.remove("flagged", "graded-ok", "graded-no");
      b.classList.add(m._ok ? "graded-ok" : "graded-no");
    });
    fillFeedback(i, m);
  }
  if (scrollToReport) $("reportCard").scrollIntoView({ behavior: "smooth", block: "start" });
}
function feedbackHtml(qid, m, prefix) {
  const ok = m._ok;
  const yourAns = S.answers[qid];
  return `<div class="fb-head">
      <span class="fb-verdict">${prefix ? `<b style="font-family:var(--mono);margin-right:5px;">${prefix}</b>` : ""}<svg class="icon"><use href="#${ok ? "i-check" : "i-x"}"/></svg>${ok ? "Correct" : "Incorrect — your answer: " + esc(labelFor(m, yourAns) || "blank")}</span>
      <button class="clue-btn" onclick="seekPlay(${m.time})"><svg class="icon"><use href="#i-vol"/></svg> Clue (${secToStr(m.time)})</button>
    </div>
    ${ok ? "" : `<div style="margin-bottom:3px;"><b>Acceptable:</b> <span style="color:var(--primary);font-weight:600;">${esc(m.answers.join(" / "))}</span></div>`}
    ${m.quote ? `<div style="color:var(--ink-3);margin-bottom:3px;"><i>Evidence:</i> “${esc(m.quote)}”</div>` : ""}
    <div style="color:var(--ink-2);"><svg class="icon" style="color:var(--amber)"><use href="#i-bulb"/></svg> ${esc(m.analysis)}</div>`;
}
function fillFeedback(qid, m) {
  const slot = $("fb-" + qid);
  if (slot) {
    slot.className = "fb " + (m._ok ? "ok" : "no");
    slot.innerHTML = feedbackHtml(qid, m, "");
    slot.hidden = false;
  }
  if (qid >= 21 && qid <= 26) { // summary blanks: feedback list under the paragraph
    const list = $("fbList");
    if (list && !list.querySelector("#sfb-" + qid)) {
      const li = document.createElement("li");
      li.id = "sfb-" + qid;
      li.innerHTML = feedbackHtml(qid, m, "Q" + qid);
      list.appendChild(li);
    }
  }
}
function setFilter(mode) {
  for (let i = 1; i <= 40; i++) {
    const m = qmeta(i);
    if (!m) continue;
    const slot = $("fb-" + i);
    if (slot) slot.hidden = mode === "wrong" ? !!m._ok : mode === "correct" ? !m._ok : false;
    if (i >= 21 && i <= 26) {
      const li = $("sfb-" + i);
      if (li) li.style.display = mode === "wrong" ? (m._ok ? "none" : "") : mode === "correct" ? (m._ok ? "" : "none") : "";
    }
  }
  document.querySelectorAll("[data-filter]").forEach(b => {
    b.style.borderColor = b.dataset.filter === mode ? "var(--primary)" : "";
    b.style.background = b.dataset.filter === mode ? "var(--primary-subtle)" : "";
  });
}

/* ================= Timer ================= */
function initTimer() {
  updateTimerPill();
  setInterval(() => {
    if (!S.started || S.evaluated) return;
    if (S.remain > 0) {
      S.remain--;
      updateTimerPill();
      if (S.remain % 10 === 0) persist();
      if (S.remain === 300) toast("5 minutes remaining.");
      if (S.remain === 60) toast("1 minute remaining!");
    }
    if (S.remain <= 0) {
      toast("Time is up — submitting automatically.", 4000);
      evaluateExam();
    }
  }, 1000);
}
function updateTimerPill() {
  const pill = $("timerPill");
  $("clockDisplay").textContent = secToStr(S.remain);
  pill.classList.toggle("warn", S.remain <= 300 && S.remain > 60);
  pill.classList.toggle("danger", S.remain <= 60);
}

/* ================= Overlays & modals ================= */
function openOverlay(id) { $(id).classList.add("open"); }
function closeOverlay(id) { $(id).classList.remove("open"); }
function openModal(id) { $(id).classList.add("open"); }
function closeModal(id) { $(id).classList.remove("open"); }

/* ================= Start flow ================= */
function beginTest(mode) {
  S.mode = mode;
  S.started = true;
  $("startOverlay").classList.remove("open");
  document.body.classList.add(mode === "exam" ? "mode-exam" : "mode-practice");
  $("modeChip").textContent = mode === "exam" ? "Exam Mode" : "Practice Mode";
  renderTabs();
  if (mode === "exam") {
    audio.play().then(() => toast("Recording started — it plays once, exactly like the real test.", 3600))
      .catch(() => toast("Press play (Space) to start the recording.", 3600));
  }
  persist();
}
function showStartOverlay(resumable) {
  $("startSub").textContent = EXAM.subtitle ? EXAM.title + " · " + EXAM.subtitle : EXAM.title;
  if (resumable) {
    const strip = $("resumeStrip");
    let done = 0;
    for (let i = 1; i <= 40; i++) if (isAnswered(i)) done++;
    let clozeDone = 0, clozeTotal = 0;
    (PASSAGE_DATA || []).forEach(p => {
      const blanks = getClozeBlanks(p.part);
      clozeTotal += blanks.length;
      blanks.forEach(b => { if ((S.clozeAnswers[b.id] || "").trim()) clozeDone++; });
    });
    strip.style.display = "";
    strip.innerHTML = `<span>检测到学习进度 — <b>环节一精听:</b> ${clozeDone}/${clozeTotal} 空 | <b>环节二模考:</b> ${done}/40 题.</span>
      <button type="button" class="btn btn-primary btn-sm" id="btnResume">继续训练</button>`;
    $("btnResume").addEventListener("click", () => {
      $("startOverlay").classList.remove("open");
      switchStage(S.stage || "cloze");
      if (S.stage === "exam" && S.mode) beginTest(S.mode);
      if (S.evaluated) evaluateExam();
    });
  }
  openOverlay("startOverlay");
}

/* ================= Demo/QA hooks (?demo=1 &grade=1 &part=2 &view=… &stage=…) ================= */
function fillDemo() {
  for (let i = 1; i <= 40; i++) {
    const m = qmeta(i);
    if (!m) continue;
    if (i % 5 === 0) { // every 5th question wrong, for visual QA
      if (m.type === "option") {
        const keys = Object.keys(m.labels || {});
        const wrong = keys.find(k => norm(k) !== norm(m.answers[0])) || "A";
        S.answers[i] = wrong;
      } else S.answers[i] = "deliberately wrong";
    } else S.answers[i] = m.answers[0];
  }
  refreshCounts();
}
function applyQueryParams() {
  const qs = new URLSearchParams(location.search);
  if (!(qs.has("demo") || qs.has("grade") || qs.has("skipstart") || qs.has("part") || qs.has("view") || qs.has("stage") || qs.has("mode"))) return;
  S.transient = true;
  if (qs.get("stage") === "1" || qs.get("stage") === "cloze") {
    switchStage("cloze");
    $("startOverlay").classList.remove("open");
    S.started = true;
  } else if (qs.get("stage") === "2" || qs.get("stage") === "exam") {
    switchStage("exam");
    $("startOverlay").classList.remove("open");
    beginTest(qs.get("mode") || "practice");
  } else if (qs.get("mode") === "exam" || qs.get("mode") === "practice") {
    switchStage("exam");
    $("startOverlay").classList.remove("open");
    beginTest(qs.get("mode"));
  }
  if (qs.has("demo")) fillDemo();
  if (qs.get("part")) {
    const p = Math.min(5, Math.max(1, parseInt(qs.get("part"), 10) || 1));
    if (S.stage === "cloze") jumpClozePart(p);
    else jumpPart(p);
  }
  if (qs.get("view") === "transcript") { switchStage("exam"); jumpPart(5); }
  if (qs.get("view") === "review") { switchStage("exam"); openReview(); }
  if (qs.has("grade")) { switchStage("exam"); if (!S.evaluated) evaluateExam(); }
}

/* ================= Reset ================= */
function resetTest() {
  try { localStorage.removeItem(LS_KEY); } catch (e) {}
  location.replace(location.pathname); // strip query params too
}

/* ================= Keyboard ================= */
function bindKeys() {
  window.addEventListener("keydown", (e) => {
    const tag = document.activeElement ? document.activeElement.tagName : "";
    const typing = tag === "INPUT" && document.activeElement.type === "text" || tag === "SELECT" || tag === "TEXTAREA";
    if (e.key === "Escape") {
      document.querySelectorAll(".overlay.open, .modal-backdrop.open").forEach(o => o.classList.remove("open"));
      return;
    }
    if ($("startOverlay").classList.contains("open")) return;
    if (typing) return;
    if (e.code === "Space") { e.preventDefault(); togglePlay(); }
    else if (e.key === "ArrowLeft" && canSeek()) audio.currentTime = Math.max(0, audio.currentTime - 5);
    else if (e.key === "ArrowRight" && canSeek()) audio.currentTime = Math.min(audio.duration || 0, audio.currentTime + 5);
    else if (e.key >= "1" && e.key <= "4") {
      if (S.stage === "cloze") jumpClozePart(parseInt(e.key, 10));
      else jumpPart(parseInt(e.key, 10));
    }
    else if (e.key === "t" || e.key === "T") {
      if (S.stage === "exam") jumpPart(activePart === 5 ? 1 : 5);
    }
    else if (e.key === "r" || e.key === "R") {
      if (S.stage === "exam") {
        if ($("reviewOverlay").classList.contains("open")) closeOverlay("reviewOverlay"); else openReview();
      }
    }
    else if (e.key === "?") openOverlay("helpOverlay");
  });
}

/* ================= Boot ================= */
document.addEventListener("DOMContentLoaded", () => {
  audio.src = AUDIO_FILE;
  document.title = (EXAM.subtitle ? EXAM.subtitle : EXAM.title) + " · IELTS Listening Training";
  $("brandSub").textContent = EXAM.subtitle || EXAM.title;
  const restored = restore();
  buildPalette();
  renderTabs();
  renderTranscript();
  bindAudio();
  bindKeys();
  initTimer();

  // Stage Switcher
  $("btnStageCloze").addEventListener("click", () => switchStage("cloze"));
  $("btnStageExam").addEventListener("click", () => switchStage("exam"));

  // Stage 1 Top Actions
  $("btnTopCheckCloze").addEventListener("click", () => checkClozePart(S.activeClozePart));
  $("btnTopRevealCloze").addEventListener("click", () => toggleRevealCloze(S.activeClozePart));

  // Start Overlay actions
  $("btnStartClozeStage").addEventListener("click", () => {
    switchStage("cloze");
    $("startOverlay").classList.remove("open");
    S.started = true;
    toast("已进入环节一：整段原文精听复现。点击任意句子播放磨耳朵，补全核心表达！", 4200);
    persist();
  });
  $("btnStartPractice").addEventListener("click", () => {
    switchStage("exam");
    beginTest("practice");
  });
  $("btnStartExam").addEventListener("click", () => {
    switchStage("exam");
    beginTest("exam");
  });

  // Dock prev / next
  $("btnPrevPart").addEventListener("click", () => {
    if (S.stage === "cloze") { if (S.activeClozePart > 1) jumpClozePart(S.activeClozePart - 1); }
    else { if (activePart > 1) jumpPart(activePart - 1); }
  });
  $("btnNextPart").addEventListener("click", () => {
    if (S.stage === "cloze") { if (S.activeClozePart < PASSAGE_DATA.length) jumpClozePart(S.activeClozePart + 1); }
    else { if (activePart < 4) jumpPart(activePart + 1); }
  });

  // Stage 2 actions
  $("btnFinish").addEventListener("click", openFinishModal);
  $("btnConfirmFinish").addEventListener("click", evaluateExam);
  $("btnGotoReview").addEventListener("click", () => { closeModal("finishModal"); openReview(); });
  $("btnReview").addEventListener("click", openReview);
  $("btnReviewFinish").addEventListener("click", evaluateExam);
  $("btnReset").addEventListener("click", () => openModal("resetModal"));
  $("btnConfirmReset").addEventListener("click", resetTest);
  $("btnHelp").addEventListener("click", () => openOverlay("helpOverlay"));
  $("btnRetake").addEventListener("click", () => openModal("resetModal"));
  $("autoscrollToggle").addEventListener("change", (e) => { autoScroll = e.target.checked; });
  document.querySelectorAll("[data-close]").forEach(b => b.addEventListener("click", () => closeOverlay(b.dataset.close)));
  document.querySelectorAll(".modal-backdrop").forEach(m => m.addEventListener("click", (e) => { if (e.target === m) m.classList.remove("open"); }));
  document.querySelectorAll("[data-filter]").forEach(b => b.addEventListener("click", () => setFilter(b.dataset.filter)));

  if (restored) {
    showStartOverlay(true);
    switchStage(S.stage || "cloze");
    if (S.mode === "exam") document.body.classList.add("mode-exam");
    else if (S.mode === "practice") document.body.classList.add("mode-practice");
    if (S.mode === "exam" && !S.evaluated && S.furthest > 0) audio.currentTime = S.furthest;
    if (S.evaluated) { updateReportUI(recomputeGrades()); renderPartView(); }
  } else {
    showStartOverlay(false);
    switchStage("cloze");
  }
  applyQueryParams();
  setInterval(() => { if (S.stage === "exam" && activePart === 5) syncTranscriptActive(audio.currentTime); }, 400);
});
</script>
</body>
</html>
