      <!-- Stage 2 Card -->
      <div class="mode-card" style="cursor:default;">
        <div style="font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:0.5px;color:var(--ink-3);">进阶实战 · Stage 2</div>
        <div class="mc-name" style="color:var(--ink);margin:4px 0;"><svg class="icon" style="color:var(--red);"><use href="#i-doc"/></svg> 雅思全真40题模考</div>
        <div class="mc-desc" style="color:var(--ink-2);font-size:12.5px;line-height:1.6;">
          剑桥标准40题全真机考，涵盖笔记填空、选择配对与短文总结，评定官方 Band 9 诊断成绩。
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px;">
          <button class="btn" id="btnStartPractice" style="font-weight:700;">练习模式</button>
          <button class="btn btn-danger" id="btnStartExam" style="font-weight:700;">全真机考</button>
        </div>
