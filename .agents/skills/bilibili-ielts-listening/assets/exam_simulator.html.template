<!-- ============ Modals ============ -->
<div class="modal-backdrop" id="finishModal" role="dialog" aria-modal="true">
  <div class="modal-card">
    <div class="modal-icon warn"><svg class="icon" style="width:34px;height:34px;"><use href="#i-send"/></svg></div>
    <h3>Submit test for grading?</h3>
